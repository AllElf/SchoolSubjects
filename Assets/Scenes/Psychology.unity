  m_Text: "\u0420\u0430\u0441\u0441\u0442\u0430\u0432\u044C \u0447\u0435\u043A-\u0431\u043E\u043A\u0441\u044B,
    \u043D\u0430\u0436\u043C\u0438 \u043D\u0438\u0436\u0435 \u043A\u043D\u043E\u043F\u043A\u0443
    \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0438 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438
