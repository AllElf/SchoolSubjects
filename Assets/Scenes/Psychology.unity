--- !u!114 &2066801618
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2066801616}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ae7f7895a6cef274b916a77e9705fa92, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  countingInformationPsychology: {fileID: 845555141}
  questionText: {fileID: 24930653}
  optionsGroup: {fileID: 2012832267}
  option1: {fileID: 1958750599}
  option2: {fileID: 814001220}
  option3: {fileID: 1292627180}
  nextButton: {fileID: 2145409991}
  resultText: {fileID: 2091990198}
  buttonPush: {fileID: 104214965}
  questions:
  - question: "\u041C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F"
    options:
    - text: "\u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C \u043B\u044E\u0431\u0443\u044E
        \u0440\u0430\u0431\u043E\u0442\u0443, \u0435\u0441\u043B\u0438 \u0437\u043D\u0430\u044E,
        \u0447\u0442\u043E \u043C\u043E\u0439 \u0442\u0440\u0443\u0434 \u043D\u0435
        \u043F\u0440\u043E\u043F\u0430\u0434\u0451\u0442 \u0434\u0430\u0440\u043E\u043C"
      groupIndex: 1
      score: 1
    - text: "\u0443\u0447\u0438\u0442\u044C\u0441\u044F \u0432\u0441\u0435\u043C\u0443
        \u043D\u043E\u0432\u043E\u043C\u0443 \u0434\u043B\u044F \u0442\u043E\u0433\u043E,
        \u0447\u0442\u043E\u0431\u044B \u0434\u043E\u0441\u0442\u0438\u0447\u044C
        \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0445
        \u0432 \u0436\u0438\u0437\u043D\u0438 \u0446\u0435\u043B\u0435\u0439"
      groupIndex: 0
      score: 1
    - text: "\u0434\u0435\u043B\u0430\u0442\u044C \u0432\u0441\u0435 \u043A\u0430\u043A
        \u043C\u043E\u0436\u043D\u043E \u043B\u0443\u0447\u0448\u0435, \u043F\u043E\u0442\u043E\u043C\u0443
        \u0447\u0442\u043E \u044D\u0442\u043E \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
        \u043C\u043D\u0435 \u0432 \u0436\u0438\u0437\u043D\u0438"
      groupIndex: 3
      score: 1
  - question: "\u042F \u0434\u0443\u043C\u0430\u044E, \u0447\u0442\u043E"
    options:
    - text: "\u043D\u0430\u0434\u043E \u0434\u0435\u043B\u0430\u0442\u044C \u0432\u0441\u0451,
        \u0447\u0442\u043E \u043F\u043E\u0440\u0443\u0447\u0430\u044E\u0442, \u043A\u0430\u043A
        \u043C\u043E\u0436\u043D\u043E \u043B\u0443\u0447\u0448\u0435, \u0442\u0430\u043A
        \u043A\u0430\u043A \u044D\u0442\u043E \u043F\u043E\u043C\u043E\u0436\u0435\u0442
        \u043C\u043D\u0435 \u0432 \u0436\u0438\u0437\u043D\u0438"
      groupIndex: 3
      score: 1
    - text: "\u0441\u0432\u043E\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u043E\u0439
        \u043D\u0430\u0434\u043E \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u044C
        \u043F\u043E\u043B\u044C\u0437\u0443 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u043C,
        \u0442\u043E\u0433\u0434\u0430 \u043E\u043D\u0438 \u043E\u0442\u0432\u0435\u0442\u044F\u0442
        \u0442\u0435\u043C \u0436\u0435"
      groupIndex: 1
      score: 1
    - text: "\u043C\u043E\u0436\u043D\u043E \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F
        \u0447\u0435\u043C \u0443\u0433\u043E\u0434\u043D\u043E, \u0435\u0441\u043B\u0438
        \u044D\u0442\u043E \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0435\u0442
        \u043A \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044E \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0445
        \u0446\u0435\u043B\u0435\u0439"
      groupIndex: 0
      score: 1
  - question: "\u042F \u043B\u044E\u0431\u043B\u044E"
    options:
    - text: "\u0443\u0437\u043D\u0430\u0432\u0430\u0442\u044C \u0447\u0442\u043E-\u0442\u043E
        \u043D\u043E\u0432\u043E\u0435, \u0435\u0441\u043B\u0438 \u043C\u043D\u0435
        \u044D\u0442\u043E \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F
        \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043C"
      groupIndex: 0
      score: 1
    - text: "\u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C \u043B\u044E\u0431\u0443\u044E
        \u0440\u0430\u0431\u043E\u0442\u0443, \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E
        \u043B\u0443\u0447\u0448\u0435, \u0435\u0441\u043B\u0438 \u044D\u0442\u043E
        \u0431\u0443\u0434\u0435\u0442 \u043A\u0435\u043C-\u0442\u043E \u0437\u0430\u043C\u0435\u0447\u0435\u043D\u043E"
      groupIndex: 2
      score: 1
    - text: "\u0434\u0435\u043B\u0430\u0442\u044C \u043B\u044E\u0431\u043E\u0435
        \u0434\u0435\u043B\u043E \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E
        \u043B\u0443\u0447\u0448\u0435, \u0442\u0430\u043A \u043A\u0430\u043A \u044D\u0442\u043E
        \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442 \u0440\u0430\u0434\u043E\u0441\u0442\u044C
        \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u043C"
      groupIndex: 1
      score: 1
  - question: "\u042F \u0441\u0447\u0438\u0442\u0430\u044E, \u0447\u0442\u043E"
    options:
    - text: "\u0433\u043B\u0430\u0432\u043D\u043E\u0435 \u0432 \u043B\u044E\u0431\u043E\u0439
        \u0440\u0430\u0431\u043E\u0442\u0435 \u2013 \u044D\u0442\u043E \u0442\u043E,
        \u0447\u0442\u043E \u043E\u043D\u0430 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442
        \u043F\u043E\u043B\u044C\u0437\u0443 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u043C"
      groupIndex: 1
      score: 1
    - text: "\u0432 \u0436\u0438\u0437\u043D\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
        \u0432\u0441\u0451 \u0438\u0441\u043F\u044B\u0442\u0430\u0442\u044C, \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
        \u0441\u0432\u043E\u0438 \u0441\u0438\u043B\u044B \u0432\u043E \u0432\u0441\u0435\u043C"
      groupIndex: 0
      score: 1
    - text: "\u0432 \u0436\u0438\u0437\u043D\u0438 \u0433\u043B\u0430\u0432\u043D\u043E\u0435
        \u2013 \u044D\u0442\u043E \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E
        \u0443\u0447\u0438\u0442\u044C\u0441\u044F \u0432\u0441\u0435\u043C\u0443
        \u043D\u043E\u0432\u043E\u043C\u0443"
      groupIndex: 2
      score: 1
  - question: "\u041C\u043D\u0435 \u043F\u0440\u0438\u044F\u0442\u043D\u043E,"
    options:
    - text: "\u043A\u043E\u0433\u0434\u0430 \u044F \u0434\u0435\u043B\u0430\u044E
        \u043B\u044E\u0431\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u0443 \u0442\u0430\u043A
        \u0445\u043E\u0440\u043E\u0448\u043E, \u043A\u0430\u043A \u044F \u044D\u0442\u043E
        \u043C\u043E\u0433\u0443"
      groupIndex: 3
      score: 1
    - text: "\u043A\u043E\u0433\u0434\u0430 \u043C\u043E\u044F \u0440\u0430\u0431\u043E\u0442\u0430
        \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442 \u043F\u043E\u043B\u044C\u0437\u0443
        \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u043C, \u0442\u0430\u043A
        \u043A\u0430\u043A \u044D\u0442\u043E \u0433\u043B\u0430\u0432\u043D\u043E\u0435
        \u0432 \u043B\u044E\u0431\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u0435"
      groupIndex: 1
      score: 1
    - text: "\u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C \u043B\u044E\u0431\u0443\u044E
        \u0440\u0430\u0431\u043E\u0442\u0443, \u043F\u043E\u0442\u043E\u043C\u0443
        \u0447\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0432\u0441\u0435\u0433\u0434\u0430
        \u043F\u0440\u0438\u044F\u0442\u043D\u043E"
      groupIndex: 0
      score: 1
  - question: "\u041C\u0435\u043D\u044F \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0435\u0442"
    options:
    - text: "\u043F\u0440\u043E\u0446\u0435\u0441\u0441 \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0435\u043D\u0438\u044F
        \u043D\u043E\u0432\u044B\u0445 \u0437\u043D\u0430\u043D\u0438\u0439 \u0438
        \u043D\u0430\u0432\u044B\u043A\u043E\u0432"
      groupIndex: 0
      score: 1
    - text: "\u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 \u043B\u044E\u0431\u043E\u0439
        \u0440\u0430\u0431\u043E\u0442\u044B \u043D\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u0435
        \u043C\u043E\u0438\u0445 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0435\u0439"
      groupIndex: 2
      score: 1
    - text: "\u043F\u0440\u043E\u0446\u0435\u0441\u0441 \u0442\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B,
        \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442
        \u044F\u0432\u043D\u0443\u044E \u043F\u043E\u043B\u044C\u0437\u0443 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u043C"
      groupIndex: 1
      score: 1
  - question: "\u042F \u0443\u0432\u0435\u0440\u0435\u043D \u0432 \u0442\u043E\u043C
      \u2013 \u0447\u0442\u043E, \u043B\u044E\u0431\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u0430 \u0442\u043E\u0433\u0434\u0430,"
    options:
    - text: "\u043A\u043E\u0433\u0434\u0430 \u043E\u043D\u0430 \u0432\u0430\u0436\u043D\u0430
        \u0438 \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u0430"
      groupIndex: 1
      score: 1
    - text: "\u043A\u043E\u0433\u0434\u0430 \u043E\u043D\u0430 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442
        \u043C\u043D\u0435 \u043F\u043E\u043B\u044C\u0437\u0443"
      groupIndex: 0
      score: 1
    - text: "\u043A\u043E\u0433\u0434\u0430 \u044F \u043C\u043E\u0433\u0443 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0438
        \u0435\u0435 \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C"
      groupIndex: 3
      score: 1
  - question: "\u041C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F"
    options:
    - text: "\u0431\u044B\u0442\u044C \u043C\u0430\u0441\u0442\u0435\u0440\u043E\u043C
        \u0441\u0432\u043E\u0435\u0433\u043E \u0434\u0435\u043B\u0430"
      groupIndex: 3
      score: 1
    - text: "\u0434\u0435\u043B\u0430\u0442\u044C \u0447\u0442\u043E-\u0442\u043E
        \u0441\u0430\u043C\u043E\u043C\u0443 \u0431\u0435\u0437 \u043F\u043E\u043C\u043E\u0449\u0438
        \u0432\u0437\u0440\u043E\u0441\u043B\u044B\u0445"
      groupIndex: 0
      score: 1
    - text: "\u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E \u0443\u0447\u0438\u0442\u044C\u0441\u044F
        \u0447\u0435\u043C\u0443-\u0442\u043E \u043D\u043E\u0432\u043E\u043C\u0443"
      groupIndex: 1
      score: 1
  - question: "\u041C\u043D\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E"
    options:
    - text: "\u0443\u0447\u0438\u0442\u044C\u0441\u044F"
      groupIndex: 0
      score: 1
    - text: "\u0434\u0435\u043B\u0430\u0442\u044C \u0432\u0441\u0451, \u0447\u0442\u043E
        \u0437\u0430\u043C\u0435\u0442\u043D\u043E \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u043C"
      groupIndex: 2
      score: 1
    - text: "\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C"
      groupIndex: 1
      score: 1
  - question: "\u042F \u0434\u0443\u043C\u0430\u044E, \u0447\u0442\u043E"
    options:
    - text: "\u0431\u044B\u043B\u043E \u0431\u044B \u043B\u0443\u0447\u0448\u0435,
        \u0435\u0441\u043B\u0438 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B
        \u043C\u043E\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u044B \u0431\u044B\u043B\u0438
        \u0432\u0438\u0434\u043D\u044B \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u043C"
      groupIndex: 2
      score: 1
    - text: "\u0432 \u043B\u044E\u0431\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u0435
        \u0432\u0430\u0436\u0435\u043D \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442"
      groupIndex: 3
      score: 1
    - text: "\u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0441\u043A\u043E\u0440\u0435\u0435
        \u043E\u0432\u043B\u0430\u0434\u0435\u0442\u044C \u043D\u0443\u0436\u043D\u044B\u043C\u0438
        \u0437\u043D\u0430\u043D\u0438\u044F\u043C\u0438 \u0438 \u043D\u0430\u0432\u044B\u043A\u0430\u043C\u0438,
        \u0447\u0442\u043E\u0431\u044B \u043C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E
        \u0441\u0430\u043C\u043E\u043C\u0443 \u0434\u0435\u043B\u0430\u0442\u044C
        \u0432\u0441\u0451, \u0447\u0442\u043E \u0445\u043E\u0447\u0435\u0442\u0441\u044F"
      groupIndex: 0
      score: 1
  - question: "\u041C\u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F"
    options:
    - text: "\u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E
        \u0442\u0435\u043C, \u0447\u0442\u043E \u043C\u043D\u0435 \u043F\u0440\u0438\u044F\u0442\u043D\u043E"
      groupIndex: 0
      score: 1
    - text: "\u043B\u044E\u0431\u043E\u0435 \u0434\u0435\u043B\u043E \u0434\u0435\u043B\u0430\u0442\u044C
        \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u043B\u0443\u0447\u0448\u0435,
        \u043F\u043E\u0441\u043A\u043E\u043B\u044C\u043A\u0443 \u0442\u0430\u043A
        \u043C\u043E\u0436\u043D\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C
        \u0432\u0441\u0451 \u0445\u043E\u0440\u043E\u0448\u043E"
      groupIndex: 3
      score: 1
    - text: "\u0447\u0442\u043E\u0431\u044B \u043C\u043E\u044F \u0440\u0430\u0431\u043E\u0442\u0430
        \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u043B\u0430 \u043F\u043E\u043B\u044C\u0437\u0443
        \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u043C, \u0442\u0430\u043A
        \u043A\u0430\u043A \u044D\u0442\u043E \u043F\u043E\u043C\u043E\u0436\u0435\u0442
        \u043C\u043D\u0435 \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043C"
      groupIndex: 1
      score: 1
  - question: "\u041C\u043D\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E"
    options:
    - text: "\u043A\u043E\u0433\u0434\u0430 \u044F \u0434\u0435\u043B\u0430\u044E
        \u043A\u0430\u043A\u043E\u0435-\u0442\u043E \u0434\u0435\u043B\u043E \u0442\u0430\u043A
        \u0445\u043E\u0440\u043E\u0448\u043E, \u043A\u0430\u043A \u044D\u0442\u043E
        \u043C\u043E\u0433\u0443\u0442 \u0434\u0435\u043B\u0430\u0442\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u0438\u0435"
      groupIndex: 3
      score: 1
    - text: "\u043A\u043E\u0433\u0434\u0430 \u044F \u043E\u0431\u0443\u0447\u0430\u044E\u0441\u044C
        \u0434\u0435\u043B\u0430\u0442\u044C \u0442\u043E, \u0447\u0435\u0433\u043E
        \u043D\u0435 \u0443\u043C\u0435\u043B \u0434\u0435\u043B\u0430\u0442\u044C
        \u0440\u0430\u043D\u044C\u0448\u0435"
      groupIndex: 0
      score: 1
    - text: "\u0434\u0435\u043B\u0430\u0442\u044C \u0442\u0435 \u0432\u0435\u0449\u0438,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u0431\u0440\u0430\u0449\u0430\u044E\u0442
        \u043D\u0430 \u0441\u0435\u0431\u044F \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435"
      groupIndex: 2
      score: 1
  - question: "\u042F \u043B\u044E\u0431\u043B\u044E"
    options:
    - text: "\u0434\u0435\u043B\u0430\u0442\u044C \u0442\u043E, \u0447\u0442\u043E
        \u043E\u0447\u0435\u043D\u044C \u0432\u0441\u0435\u043C\u0438 \u0446\u0435\u043D\u0438\u0442\u0441\u044F"
      groupIndex: 1
      score: 1
    - text: "\u0434\u0435\u043B\u0430\u0442\u044C \u043B\u044E\u0431\u043E\u0435
        \u0434\u0435\u043B\u043E, \u0435\u0441\u043B\u0438 \u043C\u043D\u0435 \u043D\u0435
        \u043C\u0435\u0448\u0430\u044E\u0442"
      groupIndex: 0
      score: 1
    - text: "\u043A\u043E\u0433\u0434\u0430 \u043C\u043D\u0435 \u0435\u0441\u0442\u044C
        \u0447\u0435\u043C \u0437\u0430\u043D\u044F\u0442\u044C\u0441\u044F"
      groupIndex: 3
      score: 1
  - question: "\u041C\u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F"
    options:
    - text: "\u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C \u043B\u044E\u0431\u0443\u044E
        \u0440\u0430\u0431\u043E\u0442\u0443, \u0442\u0430\u043A \u043A\u0430\u043A
        \u043C\u043D\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0435\u043D
        \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442"
      groupIndex: 2
      score: 1
    - text: "\u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C \u0442\u0443
        \u0440\u0430\u0431\u043E\u0442\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
        \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442 \u043F\u043E\u043B\u044C\u0437\u0443"
      groupIndex: 1
      score: 1
    - text: "\u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C \u0442\u0443
        \u0440\u0430\u0431\u043E\u0442\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
        \u043C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F"
      groupIndex: 3
      score: 1
  - question: "\u042F \u0441\u0447\u0438\u0442\u0430\u044E, \u0447\u0442\u043E \u0432
      \u043B\u044E\u0431\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u0435 \u0441\u0430\u043C\u043E\u0435
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E\u0435 \u044D\u0442\u043E"
    options:
    - text: "\u0435\u0451 \u043F\u0440\u043E\u0446\u0435\u0441\u0441"
      groupIndex: 0
      score: 1
    - text: "\u0435\u0451 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442"
      groupIndex: 2
      score: 1
    - text: "\u0442\u043E, \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u043E\u043D\u0430 \u0432\u0430\u0436\u043D\u0430 \u0434\u043B\u044F \u0434\u0440\u0443\u0433\u0438\u0445
        \u043B\u044E\u0434\u0435\u0439"
      groupIndex: 1
      score: 1
  - question: "\u041C\u043D\u0435 \u043F\u0440\u0438\u044F\u0442\u043D\u043E"
    options:
    - text: "\u0443\u0447\u0438\u0442\u044C\u0441\u044F \u0432\u0441\u0435\u043C\u0443,
        \u0447\u0442\u043E \u043C\u043D\u0435 \u043F\u043E\u0442\u043E\u043C \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F
        \u0432 \u0436\u0438\u0437\u043D\u0438"
      groupIndex: 1
      score: 1
    - text: "\u0443\u0447\u0438\u0442\u044C\u0441\u044F \u043D\u043E\u0432\u043E\u043C\u0443,
        \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E \u043E\u0442
        \u0442\u043E\u0433\u043E, \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u044D\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u043C\u043D\u0435 \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u044C\u0441\u044F"
      groupIndex: 2
      score: 1
    - text: "\u0443\u0447\u0438\u0442\u044C\u0441\u044F, \u043F\u043E\u0441\u043A\u043E\u043B\u044C\u043A\u0443
        \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u0441\u0430\u043C \u043F\u0440\u043E\u0446\u0435\u0441\u0441"
      groupIndex: 0
      score: 1
  - question: "\u041C\u0435\u043D\u044F \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0435\u0442"
    options:
    - text: "\u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u0430,
        \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F
        \u043C\u043D\u0435 \u043F\u043E\u0441\u043B\u0435 \u0443\u0447\u0451\u0431\u044B"
      groupIndex: 2
      score: 1
    - text: "\u0442\u043E, \u0447\u0442\u043E \u043F\u043E\u0441\u043B\u0435 \u0443\u0447\u0451\u0431\u044B
        \u044F \u0441\u0442\u0430\u043D\u0443 \u043D\u0443\u0436\u043D\u044B\u043C
        \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C"
      groupIndex: 1
      score: 1
    - text: "\u0442\u043E, \u0447\u0442\u043E \u0443\u0447\u0451\u0431\u0430 \u043F\u043E\u043B\u0435\u0437\u043D\u0430
        \u0434\u043B\u044F \u043C\u0435\u043D\u044F"
      groupIndex: 0
      score: 1
  - question: "\u042F \u0443\u0432\u0435\u0440\u0435\u043D \u0432 \u0442\u043E\u043C,
      \u0447\u0442\u043E"
    options:
    - text: "\u0442\u043E, \u0447\u0435\u043C\u0443 \u044F \u043D\u0430\u0443\u0447\u0443\u0441\u044C,
        \u0432\u0441\u0435\u0433\u0434\u0430 \u043C\u043D\u0435 \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F"
      groupIndex: 0
      score: 1
    - text: "\u043C\u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0442
        \u043D\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F \u0443\u0447\u0438\u0442\u044C\u0441\u044F"
      groupIndex: 2
      score: 1
    - text: "\u043F\u043E\u0441\u043B\u0435 \u0443\u0447\u0451\u0431\u044B \u044F
        \u0441\u0442\u0430\u043D\u0443 \u043D\u0443\u0436\u043D\u044B\u043C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C"
      groupIndex: 1
      score: 1
  - question: "\u041C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F"
    options:
    - text: "\u043A\u043E\u0433\u0434\u0430 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B
        \u043C\u043E\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u044B \u0432\u0438\u0434\u043D\u044B
        \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u043C"
      groupIndex: 1
      score: 1
    - text: "\u043A\u043E\u0433\u0434\u0430 \u044F \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u044E
        \u0440\u0430\u0431\u043E\u0442\u0443 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0438"
      groupIndex: 3
      score: 1
    - text: "\u043A\u043E\u0433\u0434\u0430 \u044F \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u044E
        \u0440\u0430\u0431\u043E\u0442\u0443 \u0442\u0430\u043A, \u043A\u0430\u043A
        \u044D\u0442\u043E \u043C\u043E\u0433\u0443\u0442 \u0434\u0435\u043B\u0430\u0442\u044C
        \u043D\u0435\u043C\u043D\u043E\u0433\u0438\u0435"
      groupIndex: 0
      score: 1
  - question: "\u041C\u043D\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E"
    options:
    - text: "\u043A\u043E\u0433\u0434\u0430 \u044F \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E
        \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u044E \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u043D\u043E\u0435
        \u043C\u043D\u0435 \u0434\u0435\u043B\u043E"
      groupIndex: 3
      score: 1
    - text: "\u0434\u0435\u043B\u0430\u0442\u044C \u0432\u0441\u0451, \u0447\u0442\u043E
        \u0437\u0430\u043C\u0435\u0442\u043D\u043E \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u043C"
      groupIndex: 1
      score: 1
    - text: "\u0435\u0441\u043B\u0438 \u0432\u0441\u0435 \u0437\u043D\u0430\u044E\u0442,
        \u0447\u0442\u043E \u044F \u0434\u0435\u043B\u0430\u044E \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0435"
      groupIndex: 2
      score: 1
  currentQuestion: 0
  groupScores: 00000000000000000000000000000000
  motivationAnalysis: 
  isInitialized: 1
