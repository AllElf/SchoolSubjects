  m_Text: "\u0414\u043E\u0440\u043E\u0436\u0438\u0442 \u0445\u043E\u0440\u043E\u0448\u0438\u043C
    \u043C\u043D\u0435\u043D\u0438\u0435\u043C \u0443\u0447\u0438\u0442\u0435\u043B\u044F
    \u043E \u0441\u0435\u0431\u0435, \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0441\u044F
    \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C \u0432\u0441\u0435 \u0435\u0433\u043E
    \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F, \u0432 \u0441\u043B\u0443\u0447\u0430\u0435
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438
    \u0441\u0430\u043C \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
    \u043A \u043D\u0435\u043C\u0443 \u0437\u0430 \u043F\u043E\u043C\u043E\u0449\u044C\u044E"
