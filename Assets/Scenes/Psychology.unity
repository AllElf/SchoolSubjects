  m_Text: "                \u0418\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F\n\n\u0412
    \u044D\u0442\u043E\u043C \u0442\u0435\u0441\u0442\u0435 \u0431\u0443\u0434\u0435\u0442
    8 \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0442\u044B \u0434\u043E\u043B\u0436\u0435\u043D \u0432\u044B\u0440\u0430\u0437\u0438\u0442\u044C
    \u0441\u0432\u043E\u0435 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0435 \u0438\u043B\u0438
    \u043D\u0435\u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0435, \u043F\u043E\u043B\u044C\u0437\u0443\u044F\u0441\u044C
    10-\u0431\u0430\u043B\u043B\u044C\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439
    \u043E\u0446\u0435\u043D\u043E\u043A. \u041A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u043C\u0443
    \u043E\u0442\u0440\u0438\u0446\u0430\u043D\u0438\u044E \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442
    0 \u0431\u0430\u043B\u043B\u043E\u0432, \u0431\u0435\u0437\u043E\u0433\u043E\u0432\u043E\u0440\u043E\u0447\u043D\u043E\u043C\u0443
    \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u044E \u2013 10, \u0441\u0440\u0435\u0434\u043D\u0438\u0435
    \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F \u043E\u0442 1 \u0434\u043E
    9 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442
    \u0441\u0442\u0435\u043F\u0435\u043D\u0438 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u044F
    \u2013 \u043D\u0435\u0441\u043E\u0433\u043B\u0430\u0441\u0438\u044F.\r\n\r\n"
